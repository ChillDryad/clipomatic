# -----------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual API key.
# -----------------------------------------------------------------------

# --- Local-only LLM (required) ---
# Ollama is internal to the compose stack, has no published host port, and runs
# with OLLAMA_NO_CLOUD=1. Cloud model names are rejected by the application.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:latest
HIGHLIGHT_FALLBACK_MODEL=gemma3:latest
LOCAL_LLM_MODELS=gemma3:latest,gemma4:12b

# --- Vision analysis ---
# Low-RAM defaults; raise these only on machines with ample headroom.
VISION_MODEL=gemma3:latest
VISION_SCAN_FPS=0.25
VISION_WINDOW_SECONDS=120
VISION_MAX_FRAMES=180
VISION_BATCH_SIZE=2
OLLAMA_NUM_CTX=8192

# --- Whisper (optional overrides) ---
WHISPER_MODEL=base
# auto = detects CUDA → Apple Silicon → CPU at runtime
# Override to "cuda" or "cpu" to force a specific backend
WHISPER_DEVICE=auto

# --- App ---
WORKSPACE_DIR=/app/workspace

# JWT signing keys are generated once and persisted under WORKSPACE_DIR/.keys.
# Set JWT_PRIVATE_KEY/JWT_PUBLIC_KEY only if you manage the PEM keypair externally.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Database ---
# Default: SQLite (file-based, zero setup)
# For production with PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/momiji
DATABASE_URL=sqlite+aiosqlite:////app/workspace/momiji.db

# --- YouTube OAuth ---
# Create credentials at https://console.cloud.google.com/
# Enable YouTube Data API v3, add OAuth consent screen, create Web Application credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7860/api/oauth/youtube/callback

# --- TikTok OAuth ---
# Register at https://developers.tiktok.com/ — Content Posting API access is gated
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:7860/api/oauth/tiktok/callback

# --- Instagram/Facebook OAuth ---
# Create an app at https://developers.facebook.com/
# Requires Instagram Business account linked to a Facebook Page
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:7860/api/oauth/instagram/callback

# --- Clip Studio (Source Quality Batch Export) ---
# Export quality: "source" (stream copy, zero loss), "visually_lossless" (CRF 12), "high" (CRF 18)
CLIP_STUDIO_EXPORT_QUALITY=source
# Export format: mp4, mov, mkv
CLIP_STUDIO_EXPORT_FORMAT=mp4
# Write per-clip metadata JSON alongside video files
CLIP_STUDIO_INCLUDE_METADATA=true
# Generate CMX 3600 EDL for DaVinci Resolve / Premiere Pro import
CLIP_STUDIO_GENERATE_EDL=false

# --- Resource profile ---
# low: 8GB systems; standard: 16GB; high: 32GB+
RAM_TIER=standard
OLLAMA_MEMORY_LIMIT=9g
CELERY_MEMORY_LIMIT=3g
BACKEND_MEMORY_LIMIT=1g
REDIS_MAXMEMORY=256mb
CELERY_MAX_TASKS_PER_CHILD=1
