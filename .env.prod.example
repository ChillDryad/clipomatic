# Production environment variables
# Copy to .env.prod and customize for your deployment

# --- LLM (points to shared Ollama) ---
LLM_BASE_URL=http://ollama-shared:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:latest
HIGHLIGHT_LLM_MODEL=gemma4:12b
OLLAMA_NUM_CTX=8192

# --- Whisper ---
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# --- Workspace ---
WORKSPACE_DIR=/app/workspace

# JWT signing keys persist under WORKSPACE_DIR/.keys.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:////app/workspace/momiji.db

# --- Resource profile ---
RAM_TIER=standard
OLLAMA_MEMORY_LIMIT=9g
CELERY_MEMORY_LIMIT=3g
BACKEND_MEMORY_LIMIT=1g
REDIS_MAXMEMORY=256mb
CELERY_MAX_TASKS_PER_CHILD=1

# --- OAuth (configure for production domain) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/youtube/callback

TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/tiktok/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/instagram/callback
