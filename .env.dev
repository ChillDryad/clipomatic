# Development environment variables
# Copy to .env.dev and customize as needed

# --- LLM (isolated compose-only Ollama; cloud routing disabled) ---
LLM_BASE_URL=http://ollama-shared:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:latest
HIGHLIGHT_FALLBACK_MODEL=gemma3:latest
LOCAL_LLM_MODELS=gemma3:latest,gemma4:12b
VISION_MODEL=gemma3:latest
VISION_SCAN_FPS=1
VISION_WINDOW_SECONDS=60
VISION_MAX_FRAMES=360
VISION_BATCH_SIZE=4

# --- Whisper ---
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# --- Workspace ---
WORKSPACE_DIR=/app/workspace

# --- Auth secrets (development) ---
JWT_SECRET=dev-secret-change-in-prod
OAUTH_ENCRYPTION_KEY=ddqdwvoAu_MG_YAjwNeXJgdXyIIplVOZs1znMBMHzeA=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:////app/workspace/momiji.db

# --- OAuth (localhost for development) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7861/api/oauth/youtube/callback

TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:7861/api/oauth/tiktok/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:7861/api/oauth/instagram/callback
