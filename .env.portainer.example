# Portainer stack variables for Clipomatic
#
# Provider configuration happens in the browser on first visit. The setup wizard
# creates the owner account and saves provider credentials encrypted under the
# persistent clipomatic-workspace volume. Do not add OpenAI or Ollama keys here.

# Pin to a published `sha-...` image tag for reproducible deployment.
IMAGE_TAG=latest
PORT=7865

# Infrastructure / resource profile (low=8GB, standard=16GB, high=32GB+)
RAM_TIER=standard
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
OLLAMA_MEMORY_LIMIT=9g
CELERY_MEMORY_LIMIT=3g
BACKEND_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=384m
REDIS_MAXMEMORY=256mb
CELERY_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=1
CELERY_MAX_MEMORY_KB=2621440
OLLAMA_NUM_CTX=8192

# The initial setup wizard offers:
# - Local Ollama (default endpoint http://ollama:11434/v1)
# - OpenAI (default endpoint https://api.openai.com/v1)
# - Any OpenAI-compatible endpoint
#
# API keys are submitted over the UI and stored encrypted at rest. They are
# never returned by the configuration API or committed to this file.
#
# Upgrading an existing deployment with encrypted OAuth credentials? Set its
# old OAUTH_ENCRYPTION_KEY once; it is copied into the workspace volume, then
# remove it from Portainer after the first successful boot.

# Clip tuning defaults (may be adjusted later in Settings)
HIGHLIGHT_CONTEXT_CARRYOVER=120
HIGHLIGHT_PRIORITY_WINDOW=30
HIGHLIGHT_PRIORITY_BOOST=10
HIGHLIGHT_MAX_CLIP_DURATION=120
