# Required Portainer stack environment variables
#
# Set these in Portainer's Stack environment-variable section. Do not commit
# your real values to source control.

# Image version published by GitHub Actions. Prefer a SHA tag in production.
IMAGE_TAG=latest

# Public UI port on the Docker host.
PORT=7865

# Required: generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Resource profile (low=8GB, standard=16GB, high=32GB+)
RAM_TIER=standard
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
OLLAMA_MEMORY_LIMIT=9g
CELERY_MEMORY_LIMIT=3g
BACKEND_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=384m
REDIS_MAXMEMORY=256mb
CELERY_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=1
CELERY_MAX_MEMORY_KB=2621440
OLLAMA_NUM_CTX=8192

# Default local models. Pull them after deployment:
# docker exec -it <stack>_ollama_1 ollama pull gemma3:latest
# docker exec -it <stack>_ollama_1 ollama pull gemma4:12b
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:latest
VISION_MODEL=gemma3:latest
HIGHLIGHT_LLM_BASE_URL=http://ollama:11434/v1
HIGHLIGHT_LLM_API_KEY=ollama
HIGHLIGHT_LLM_MODEL=gemma4:12b
HIGHLIGHT_FALLBACK_MODEL=gemma3:latest
LLM_ALLOW_CLOUD=0

# Optional: cloud highlight detection. Enable only when you intentionally
# provide a scoped/revocable cloud gateway credential in Portainer.
# LLM_ALLOW_CLOUD=1
# HIGHLIGHT_LLM_BASE_URL=https://your-ollama-gateway.example/v1
# HIGHLIGHT_LLM_API_KEY=replace-with-scoped-gateway-token
# HIGHLIGHT_LLM_MODEL=gemma4:31b-cloud

# Yap-session tuning defaults.
HIGHLIGHT_CONTEXT_CARRYOVER=120
HIGHLIGHT_PRIORITY_WINDOW=30
HIGHLIGHT_PRIORITY_BOOST=10
HIGHLIGHT_MAX_CLIP_DURATION=120
